pipeline {
    agent any
    
    environment {
		SONAR_TOKEN = credentials('sonar-token')
	}
	
    stages {
        
        stage("build & test") {
            steps {
                withMaven(maven: 'maven3.9.9'){
                    sh 'mvn clean package'
                }
            }
        }  
        
        // sonar qube quality check analysis
        stage("static code analysis SonarQue") {
			steps {
				withMaven(maven: 'maven3.9.9') {
					sh 'mvn sonar:sonar -Dsonar.host.url=http://localhost:9000 -Dsonar.token=$SONAR_TOKEN'
				}
			}
		}  
        
        stage("public URL") {
            steps {
                echo "Application URL: http://localhost:8081"
            }
        }
        
        stage("Deploy") {
            steps {
                echo "Deploying application"
                echo "Deployement successful (mockeed)"
            }
        }
    }
    
    post {
        success {
            echo "pipeline executed successfully"
        }
        
        failure {
            echo "pipeline failed to execute"
        }
    }
}